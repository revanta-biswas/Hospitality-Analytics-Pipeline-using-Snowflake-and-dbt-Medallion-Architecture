# 🔹 Python
__pycache__/
*.py[cod]
*$py.class
*.so

# 🔹 Virtual Environment
.venv/
venv/
env/

# 🔹 Environment variables
.env
.env.*

# 🔹 Logs
*.log

# 🔹 OS files
.DS_Store
Thumbs.db

# 🔹 VS Code
.vscode/

# 🔹 Jupyter Notebook
.ipynb_checkpoints/

# 🔹 dbt
target/
dbt_packages/
logs/

# 🔹 Snowflake / temp data
*.csv
*.parquet
*.json
# 🔴 AIRE CI/eval artifacts are real, tracked config — not generated Snowflake output. The blanket
#    *.json rule above would otherwise silently drop tests/.evals/config.json, the rubrics and the
#    per-work-unit ci-manifest.d/ fragments (common/ci-pipeline-generation.md Section 4.0f.1).
!tests/.evals/config.json
!tests/.evals/rubrics/**/*.json
!tests/.evals/ci-manifest.d/**/*.json

# 🔹 Build / Distribution
build/
dist/
*.egg-info/

# 🔹 uv (if using)
.venv/
.python-version

# 🔹 IDEs
.idea/

# 🔹 Misc
*.tmp
*.bak

*.toml
*.lock
!pyproject.toml
!sonar-project.properties

# 🔹 AIRE CI scratch state — never committed, purged at the start of every CI run
#    (common/ci-pipeline-generation.md Section 4.0e). The story's own reports/eval-evidence/story-*/
#    directory IS tracked; only this scratch working directory is ignored.
tests/.evals/_run/
