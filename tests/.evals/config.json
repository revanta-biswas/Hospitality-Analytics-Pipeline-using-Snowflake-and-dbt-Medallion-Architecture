{
  "evalFrameworkVersion": "1.0.0",
  "scope": "changed-files",
  "retryLimitForSelfRepair": 3,
  "thresholds": {
    "lintErrorsAllowedDelta": 0,
    "typeErrorsAllowed": 0,
    "semgrepFindingsAllowed": { "critical": 0, "high": 0, "medium": 5 },
    "dependencyVulnerabilitiesAllowed": { "critical": 0, "high": 0 },
    "disallowedLicenses": ["GPL-2.0", "GPL-3.0", "AGPL-3.0", "SSPL-1.0"],
    "maxCyclomaticComplexity": 12,
    "secretFindingsAllowed": 0,
    "unitTestCoverageMin": 90.0,
    "behaviorScenarioPassRateMin": 100.0,
    "llmJudgeArchitectureScoreMin": 0.85,
    "llmJudgeSecurityScoreMin": 0.85,
    "securityVulnerabilitiesAllowed": 0
  },
  "behavior": {
    "containerRuntime": "podman",
    "image": "aire-behavior:local",
    "containerfile": "tests/.evals/behavior/Containerfile",
    "entrypoint": "tests/.evals/behavior/run.sh",
    "_comment": "Same image + command locally and in CI. A missing runtime degrades to native execution, recorded, never blocking."
  },
  "sonarqube": {
    "enabled": true,
    "_comment": "Set true when CI generation creates sonar-project.properties and the user answers proceed at the setup gate. Additive to semgrep, never a replacement."
  },
  "judge": { "model": "claude-sonnet-5", "rubricVersion": "1.0.0" },
  "ci": {
    "baseBranch": "main",
    "integrationBranchPrefixes": ["epic", "bug", "enh", "ci", "story", "ve"],
    "manifestState": "resolved",
    "roots": [
      {
        "root": ".",
        "stack": "python",
        "runtimeVersion": "3.12",
        "markerFile": "pyproject.toml",
        "installCommands": ["pip install -e .", "pip install dbt-core dbt-snowflake"],
        "buildCommand": null,
        "coverageCommand": null,
        "noTestsExitCode": 5,
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": null,
        "coverageFormat": null,
        "sourcePaths": ["src/dbt_code", "src/snowflake"],
        "testPaths": ["tests/unit"],
        "tools": ["semgrep", "pip-audit", "gitleaks", "ruff", "mypy", "pip-licenses", "radon"],
        "toolInstallCommands": {
          "semgrep": "pip install \"semgrep==1.177.0\"",
          "pip-audit": "pip install \"pip-audit==2.9.0\"",
          "gitleaks": "gitleaks_version=8.21.2; curl -sSfL \"https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}/gitleaks_${gitleaks_version}_linux_x64.tar.gz\" | tar xz -C /usr/local/bin gitleaks",
          "ruff": "pip install \"ruff==0.9.6\"",
          "mypy": "pip install \"mypy==1.15.0\"",
          "pip-licenses": "pip install \"pip-licenses==5.0.0\"",
          "radon": "pip install \"radon==6.0.1\""
        }
      }
    ],
    "gates": ["D1_lint", "D2_types", "D3_sast", "D4_deps", "D5_licenses", "D6_complexity", "D7_secrets",
              "unitCoverage", "behaviorB1", "behaviorB2", "behaviorB3", "J1_architecture", "J2_security",
              "sonarqube"],
    "_rootsComment": "This repo is a dbt project with no traditional Python application code under src/dbt_code or src/snowflake (0 .py files at generation time) — noTestsExitCode/coverageCommand are placeholders since story ACs are verified via dbt parse/compile (REQ-NF-02), not pytest coverage. D1/D2/D6 (ruff/mypy/radon) still run for real on any .py file a future story adds under sourcePaths; today they scan zero files and report a real, tool-verified clean result rather than a fabricated N/A. D3/D4/D5/D7 (semgrep/pip-audit/pip-licenses/gitleaks) apply to the existing Python dependency graph, YAML and SQL surface today.",
    "_comment": "CI SINGLE SOURCE OF TRUTH. The generated pipeline AND every local step read THIS block."
  }
}
